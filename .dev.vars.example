# Cloudflare Access (required in production).
# TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# --- Fork additions (haouache deploy) --------------------------------

# Drafter — Anthropic Claude Haiku 4.5 takes over from Kimi when set.
# DEFAULT_DRAFTER lives in wrangler.jsonc vars; flip it to "claude" to make
# Claude the default for every mailbox without a per-mailbox override.
ANTHROPIC_API_KEY=
ANTHROPIC_DAILY_CAP_USD=1.0

# Matrix notifier — new-email events post to MATRIX_ROOM_HERMES.
MATRIX_TOKEN=
MATRIX_ROOM_HERMES=

# agentmemory — pushes inbox lifecycle events so Hermes / ClaudeClaw recall them.
AGENTMEMORY_SECRET=
